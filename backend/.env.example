# Leave empty to run the API with its local mock reply provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MINGLE_CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*,http://10.0.2.2:*

# PostgreSQL is intentionally not required by the privacy-first MVP.
# Configure only when adding account-scoped data and migrations.
DATABASE_URL=postgresql+asyncpg://mingle:mingle@localhost:5432/mingle
